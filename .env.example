# =============================================================================
# DR RIA'S E-COMMERCE PLATFORM — CLIENT CREDENTIALS TEMPLATE
# =============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the credentials below following the step-by-step instructions in
#    /docs/CLIENT-HANDOVER.md.
# 3. NEVER commit .env.local or paste live secrets into source code!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASE SITE CONFIGURATION
# -----------------------------------------------------------------------------
# Public canonical URL of your website (used for OpenGraph and OAuth callbacks)
# Development: http://localhost:3000
# Production: https://drrias.in
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# 2. SUPABASE (Database, Row-Level-Security & Session Auth)
# -----------------------------------------------------------------------------
# Where to get it:
# Log in to https://supabase.com -> select project -> Project Settings -> API
#
# Project URL (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=

# Public Publishable Key (Safe for browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / Service Role Key (SERVER ONLY — NEVER expose to browser or client bundle!)
# Found in Supabase -> Project Settings -> API -> Project API Keys -> secret / service_role
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (One-Click Customer Login)
# -----------------------------------------------------------------------------
# Where to get it:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/) -> APIs & Services -> Credentials
# 2. Create "OAuth 2.0 Client ID" (Web Application)
# 3. Set Authorized Redirect URI:
#    https://<YOUR-PROJECT-ID>.supabase.co/auth/v1/callback
# 4. Paste the credentials into Supabase Dashboard -> Authentication -> Providers -> Google
#
# Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Client Secret from Google Cloud Console (CONFIDENTIAL)
GOOGLE_CLIENT_SECRET=

# Set to "true" once enabled in Supabase to dismiss setup badges
NEXT_PUBLIC_GOOGLE_AUTH_CONFIGURED=false

# -----------------------------------------------------------------------------
# 4. SMS PROVIDER (+91 Mobile OTP Login)
# -----------------------------------------------------------------------------
# Where to get it:
# Indian TRAI compliance requires DLT registration. Choose either "msg91" or "twilio".
# In Supabase -> Authentication -> Providers -> Phone: configure your SMS gateway.
#
# Chosen provider: "msg91" | "twilio"
SMS_PROVIDER=

# API Key or Auth Token from your SMS provider dashboard
SMS_API_KEY=

# 6-character approved sender ID / Header registered with DLT (e.g. DRRIAS)
SMS_SENDER_ID=

# Registered DLT Content Template ID for OTP verification message
SMS_DLT_TEMPLATE_ID=

# Set to "true" once provider and DLT approval are active to enable mobile OTP
NEXT_PUBLIC_SMS_CONFIGURED=false

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Order Receipts & Email OTP)
# -----------------------------------------------------------------------------
# Where to get it:
# Sign up at https://resend.com -> API Keys -> Create API Key
# (Alternatively configure custom SMTP in Supabase -> Project Settings -> Auth -> SMTP)
#
# Resend API Key (starts with re_... — both RESEND_API_KEY and EMAIL_PROVIDER_API_KEY are supported)
RESEND_API_KEY=
EMAIL_PROVIDER_API_KEY=

# Verified sender email address (must match your domain DNS records)
EMAIL_FROM=

# -----------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (UPI, Cards, Netbanking)
# -----------------------------------------------------------------------------
# Where to get it:
# Log in to https://dashboard.razorpay.com -> Settings -> API Keys
#
# Public Key ID (starts with rzp_live_ or rzp_test_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Secret Key (CONFIDENTIAL — server-side only)
RAZORPAY_KEY_SECRET=

# Webhook Secret:
# In Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# URL: https://drrias.in/api/webhooks/razorpay
# Active Events: order.paid, payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 7. OPTIONAL HEALTH CHECK & MONITORING
# -----------------------------------------------------------------------------
# Optional secret token to protect /api/health (leave blank for open health check)
HEALTH_CHECK_SECRET=

# -----------------------------------------------------------------------------
# 8. ADMIN DASHBOARD & SECURITY (Server-Only Secrets)
# -----------------------------------------------------------------------------
# Dedicated HMAC-SHA256 signing secret for admin session cookies (min 32 random characters).
# NEVER reuse SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY as this secret.
# Generate via: openssl rand -hex 32
ADMIN_COOKIE_SECRET=
