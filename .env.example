# =============================================================================
# DR RIA'S E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the credentials below following the step-by-step instructions in
#    /docs/CLIENT-HANDOVER.md.
# 3. For Vercel deployments, add each variable in Project Settings -> Environment Variables.
#    Mark all server keys as "Sensitive".
# 4. NEVER commit .env.local or paste live secrets into source control!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASE SITE CONFIGURATION
# -----------------------------------------------------------------------------
# Scope: Production & Preview | Sensitive: No
# Public canonical base URL (used for OpenGraph, sitemaps, and auth redirects)
# Development: http://localhost:3000
# Production: https://drrias.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. SUPABASE (Database, Row-Level Security, Auth & Storage)
# -----------------------------------------------------------------------------
# Where to find in Supabase:
# Log in to https://supabase.com -> Project Settings -> API
#
# Scope: Production & Preview | Sensitive: No
# Supabase Project HTTPS URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://xhjkczndewkocqwsebry.supabase.co

# Scope: Production & Preview | Sensitive: No
# Supabase Publishable / Anon Key (safe for browser, RLS enforced)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Scope: Production & Preview | Sensitive: YES (Server only — NEVER expose to browser)
# Supabase Secret / Service Role Key (used for webhooks, audit logging, admin operations)
SUPABASE_SECRET_KEY=

# Scope: Production & Preview | Sensitive: YES (Server only)
# Supabase Transaction Pooler connection string (port 6543 or 5432 pooler).
# In Supabase -> Project Settings -> Database -> Connection string -> URI (Transaction mode).
# MUST use the transaction pooler to avoid exhausting serverless connection limits.
DATABASE_URL=postgresql://postgres.xhjkczndewkocqwsebry:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------------------
# 3. ADMIN DASHBOARD & SECURITY (Server-Only Secrets)
# -----------------------------------------------------------------------------
# Scope: Production & Preview (generate a separate unique secret per environment)
# Sensitive: YES (Server only)
# Dedicated HMAC-SHA256 signing secret for admin session cookies (min 32 random characters).
# Generate via: openssl rand -base64 48
# NEVER reuse SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
ADMIN_COOKIE_SECRET=

# -----------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY (UPI, Cards, Netbanking)
# -----------------------------------------------------------------------------
# Where to find in Razorpay:
# Log in to https://dashboard.razorpay.com -> Settings -> API Keys
#
# Scope: Production & Preview | Sensitive: No
# Public Key ID for client-side checkout modal (starts with rzp_live_ or rzp_test_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Scope: Production & Preview | Sensitive: YES (Server only)
# Server-side Key ID (optional fallback: resolved via getRazorpayKeyId())
RAZORPAY_KEY_ID=

# Scope: Production & Preview | Sensitive: YES (Server only)
# Secret Key used for server-side HMAC signature verification and order creation
RAZORPAY_KEY_SECRET=

# Scope: Production & Preview | Sensitive: YES (Server only)
# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
# URL: https://drrias.in/api/webhooks/razorpay
# Events: order.paid, payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Order Receipts & Customer Notifications)
# -----------------------------------------------------------------------------
# Where to get it: https://resend.com -> API Keys
#
# Scope: Production & Preview | Sensitive: YES (Server only)
# Resend API Key (starts with re_...)
RESEND_API_KEY=

# Scope: Production & Preview | Sensitive: No
# Verified sender email address matching your domain DNS records
EMAIL_FROM=Dr Ria's <orders@drrias.in>

# -----------------------------------------------------------------------------
# 6. OPTIONAL: GOOGLE OAUTH 2.0 (One-Click Customer Login)
# -----------------------------------------------------------------------------
# Scope: Production & Preview | Sensitive: YES (Client Secret)
# Configured in Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client ID
# Callback URL: https://<PROJECT-ID>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_CONFIGURED=false

# -----------------------------------------------------------------------------
# 7. OPTIONAL: SMS GATEWAY (+91 Mobile OTP Login — TRAI DLT Required)
# -----------------------------------------------------------------------------
# Scope: Production & Preview | Sensitive: YES (API Key)
# Provider: "msg91" | "twilio"
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=
NEXT_PUBLIC_SMS_CONFIGURED=false

# -----------------------------------------------------------------------------
# 8. OPTIONAL: HEALTH CHECK & MONITORING
# -----------------------------------------------------------------------------
# Scope: Production & Preview | Sensitive: YES
# Bearer secret token to protect /api/health endpoint diagnostics
HEALTH_CHECK_SECRET=
